# .env.example - PulseOps AI Configuration
# Copy this file to .env and configure your settings

# ---- AI Engine ----
# Leave empty for offline demo mode (no API key needed)
# Set to a valid key for live AI synthesis
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---- Application ----
APP_ENV=development
DATABASE_URL=sqlite:///./pulseops.db
